{
	"defaults": {"speed": 34, "voice": "low"},

	"camera": {"focus": "middle", "zoom": 1.9},

	"marks": {
		"offstage": [-80, 440],
		"door": [90, 440],
		"middle": [330, 420],
		"bench": [520, 400],
		"far_bench": [610, 400]
	},

	"cast": {
		"you": {"name": "Knight", "sprite": "player", "facing": "right"},
		"tinker": {"name": "Old Tinker", "sprite": "wizzard_m", "at": "far_bench", "facing": "left"}
	},

	"beats": [
		{
			"text": "The seal held for a thousand years.",
			"do": [{"fade": "in", "time": 1.2}]
		},
		{
			"text": "It held because nothing on the far side had ever thought to knock."
		},
		{
			"do": [
				{"enter": "you", "at": "offstage", "to": "door", "speed": 64},
				{"sfx": "extract"}
			]
		},
		{
			"text": "Someone has now.",
			"hold": 0.35
		},
		{
			"do": [
				{"move": "you", "to": "middle", "speed": 58},
				{"camera": {"focus": "middle", "zoom": 1.25, "time": 0.9}}
			]
		},
		{
			"say": "tinker",
			"text": "You're late. The kettle's been through two wars.",
			"do": [{"face": "tinker", "toward": "you"}]
		},
		{
			"say": "tinker",
			"text": "Every skill you'll ever carry is a circuit. Parts, wire, and a way out.",
			"do": [{"move": "tinker", "to": "bench", "speed": 42}]
		},
		{
			"say": "you",
			"text": "And if I wire it wrong?",
			"do": [{"face": "you", "toward": "tinker"}]
		},
		{
			"say": "tinker",
			"text": "Then it does something. Rarely the something you drew.",
			"do": [
				{"anim": "tinker", "play": "hit"},
				{"sfx": "place"},
				{"camera": {"shake": 5}}
			]
		},
		{
			"do": [{"anim": "tinker", "play": "idle"}, {"wait": 0.4}]
		},
		{
			"say": "tinker",
			"text": "Bench is yours. Break whatever you like — nothing in here stays broken."
		},
		{
			"text": "The seal is still holding.",
			"do": [{"camera": {"focus": "middle", "zoom": 1.0, "time": 1.4}}]
		},
		{
			"text": "It has not been asked a question in a thousand years.",
			"hold": 0.4
		},
		{
			"do": [{"fade": "out", "time": 1.0}, {"wait": 1.0}]
		}
	]
}
